{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build plugin",
            "type": "shell",
            "command": "mvn clean package",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Deploy to server",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\deploy.ps1"],
            "dependsOn": "Build plugin",
            "problemMatcher": []
        }
    ]
}
