{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build plugin",
            "type": "shell",
            "command": "mvn clean package",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Deploy to server",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-Command",
                "$dir = 'E:\\.programming\\Projects\\.minecraft\\.servers\\SkyMinigames\\plugins'; Remove-Item \"$dir\\SkyLogin-*.jar\" -ErrorAction SilentlyContinue; Copy-Item 'target\\SkyLogin-*.jar' $dir; Write-Host 'Copied to' $dir"
            ],
            "dependsOn": "Build plugin",
            "problemMatcher": []
        }
    ]
}
